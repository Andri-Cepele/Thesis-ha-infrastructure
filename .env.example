# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# ── Tailscale IPs of your nodes (used in compose files and scripts) ──
MANAGER_TAILSCALE_IP=100.x.x.x
WORKER1_TAILSCALE_IP=100.x.x.x
WORKER2_TAILSCALE_IP=100.x.x.x

# ── Nextcloud ──
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=change-me
NEXTCLOUD_DB_ROOT_PASSWORD=change-me-too
NEXTCLOUD_DB_NAME=nextcloud

# ── Immich ──
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=change-me
IMMICH_DB_NAME=immich

# ── Grafana ──
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-to-something-strong

# Gmail SMTP for alerting (use an App Password, not your real Gmail password)
# https://myaccount.google.com/apppasswords
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your-alerting-address@gmail.com
GF_SMTP_PASSWORD=your-16-char-app-password
GF_SMTP_FROM_ADDRESS=your-alerting-address@gmail.com
GF_ALERT_RECIPIENT=your-real-inbox@gmail.com
